    return foundCount;
}

// Clear suspicious processes from log
void clearSuspiciousActivity() {
    printf("\n[*] Clearing suspicious activity...\n");
    
    for (int i = 0; i < suspiciousLog.count; i++) {
        printf("[+] Removing: %s (PID: %d) detected at %s\n",
               suspiciousLog.processes[i].processName,
               suspiciousLog.processes[i].pid,
               suspiciousLog.processes[i].timestamp);
    }
    
    suspiciousLog.count = 0;
    printf("[+] Activity log cleared successfully\n");
}

// Display current suspicious activity
void displayActivityLog() {
    printf("\n========== SUSPICIOUS ACTIVITY LOG ==========\n");
    
    if (suspiciousLog.count == 0) {
        printf("No suspicious activity detected.\n");
        return;
    }
    
    for (int i = 0; i < suspiciousLog.count; i++) {
        printf("%d. Process: %s | PID: %d | Score: %d%% | Time: %s\n",
               i + 1,
               suspiciousLog.processes[i].processName,
               suspiciousLog.processes[i].pid,
               suspiciousLog.processes[i].suspicionScore,
               suspiciousLog.processes[i].timestamp);
    }
    printf("=============================================\n");
}

// Main antivirus scan routine
