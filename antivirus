#define MAX_PROCESSES 100
#define MAX_LOG_SIZE 1000
#include <windows.h>
#include <stdio.h>

int background() {
    // Get the console handle
    HANDLE hConsole = GetStdHandle(STD_OUTPUT_HANDLE);

    // Get the console window handle
    HWND consoleWindow = GetConsoleWindow();
    HDC hdc = GetDC(consoleWindow);

    if (hdc == NULL) {
        printf("Error: Unable to get device context.\n");
        return 1;
    }

    // Define light pink color (RGB)
    COLORREF lightPink = RGB(255, 182, 193);

    // Get console window dimensions
    RECT rect;
    GetClientRect(consoleWindow, &rect);

    // Fill the background with light pink
    HBRUSH brush = CreateSolidBrush(lightPink);
    FillRect(hdc, &rect, brush);

    // Release resources
    DeleteObject(brush);
    ReleaseDC(consoleWindow, hdc);

typedef struct {
    char processName[256];
    int pid;
    int suspicionScore;
    char timestamp[64];
} SuspiciousProcess;

typedef struct {
    SuspiciousProcess processes[MAX_PROCESSES];
    int count;
} ActivityLog;

ActivityLog suspiciousLog = {0};

// Get current timestamp
void getTimestamp(char *buffer) {
    time_t now = time(NULL);
    struct tm *timeinfo = localtime(&now);
    strftime(buffer, 64, "%Y-%m-%d %H:%M:%S", timeinfo);
}

// Scan for suspicious activity patterns
int scanForSuspiciousActivity() {
    printf("[*] Scanning for suspicious activity...\n");
    
    // Check for suspicious process names
    const char *suspiciousPatterns[] = {
        "cmd.exe", "powershell.exe", "reg.exe", "tasklist.exe",
        "wget.exe", "curl.exe", "nc.exe", "backdoor", "trojan"
    };
    
    int foundCount = 0;
    
    for (int i = 0; i < 9; i++) {
        // Simulate detection logic
        if (rand() % 10 < 3) {  // 30% chance of detection
            SuspiciousProcess proc = {0};
            strcpy_s(proc.processName, sizeof(proc.processName), suspiciousPatterns[i]);
            proc.pid = 1000 + rand() % 5000;
            proc.suspicionScore = 50 + rand() % 50;
            getTimestamp(proc.timestamp);
            
            if (suspiciousLog.count < MAX_PROCESSES) {
                suspiciousLog.processes[suspiciousLog.count++] = proc;
                foundCount++;
                printf("[!] Suspicious process detected: %s (PID: %d) - Score: %d%%\n",
                       proc.processName, proc.pid, proc.suspicionScore);
            }
        }
    }
    
    return foundCount;
}

// Check registry for suspicious modifications./my_program.exe

int checkRegistry() {
    printf("[*] Checking registry for suspicious modifications...\n");
    
    const char *suspiciousKeys[] = {
        "HKLM\\Software\\Microsoft\\Windows\\Run",
        "HKCU\\Software\\Microsoft\\Windows\\CurrentVersion\\Run",
        "HKLM\\System\\CurrentControlSet\\Services"
    };
    
    int foundCount = 0;
    
    for (int i = 0; i < 3; i++) {
        if (rand() % 10 < 2) {  // 20% chance
            printf("[!] Suspicious registry entry found in %s\n", suspiciousKeys[i]);
            foundCount++;
        }
    }
    
    return foundCount;
}

// Check for unusual network connections
int checkNetworkConnections() {
    printf("[*] Checking network connections...\n");
    
    const char *suspiciousIPs[] = {
        "192.168.1.100", "10.0.0.50", "172.16.0.1"
    };
    
    int foundCount = 0;
    
